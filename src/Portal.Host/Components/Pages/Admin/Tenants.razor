@page "/admin/tenants"
@attribute [Authorize(Policy = PlatformPermissions.TenantsManage)]
@using Portal.SharedKernel.Authorization
@using Portal.SharedKernel.Tenancy
@using Portal.Tenancy
@inject TenantAdminService Admin

<PageTitle>@L["Tenants"]</PageTitle>

<h3>@L["Tenants"]</h3>

@if (_message is not null)
{
    <div class="alert alert-success py-2">@_message</div>
}
@if (_error is not null)
{
    <div class="alert alert-danger py-2">@_error</div>
}

<button class="btn btn-primary btn-sm mb-3" @onclick="StartCreate">@L["New tenant"]</button>

<table class="table table-sm align-middle">
    <thead>
        <tr>
            <th>@L["Identifier"]</th>
            <th>@L["Name"]</th>
            <th>@L["Isolation"]</th>
            <th>@L["Modules"]</th>
            <th>@L["Status"]</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var t in _tenants)
        {
            <tr>
                <td>@t.Identifier</td>
                <td>@t.Name</td>
                <td>@L[t.Isolation.ToString()]</td>
                <td>
                    @foreach (var m in t.Modules.Where(m => m.IsEnabled))
                    {
                        <span class="badge text-bg-secondary me-1"
                              title="@(m.ExpiresAt is null ? L["No expiry"].Value : L["Expires {0}", m.ExpiresAt.Value.ToString("yyyy-MM-dd")].Value)">@ModuleTitle(m.Name)</span>
                    }
                </td>
                <td>@(t.IsActive ? L["Active"] : L["Inactive"])</td>
                <td class="text-end">
                    @if (t.Id != PlatformTenant.Id)
                    {
                        <button class="btn btn-outline-secondary btn-sm" @onclick="() => StartEdit(t.Id)">@L["Edit"]</button>
                        <button class="btn btn-outline-warning btn-sm" @onclick="() => ToggleActive(t)">@(t.IsActive ? L["Deactivate"] : L["Activate"])</button>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

@if (_edit is not null)
{
    <div class="card mt-3">
        <div class="card-body">
            <h5>@(_edit.Id is null ? L["New tenant"] : L["Edit tenant"])</h5>

            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">@L["Identifier"]</label>
                    <input class="form-control" @bind="_edit.Identifier" />
                </div>
                <div class="col-md-8">
                    <label class="form-label">@L["Name"]</label>
                    <input class="form-control" @bind="_edit.Name" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">@L["Isolation"]</label>
                    <select class="form-select" @bind="_edit.Isolation" disabled="@(_edit.Id is not null)">
                        @foreach (var v in Enum.GetValues<TenantIsolation>())
                        {
                            <option value="@v">@L[v.ToString()]</option>
                        }
                    </select>
                </div>
                @if (_edit.Isolation == TenantIsolation.DedicatedDatabase)
                {
                    <div class="col-md-8">
                        <label class="form-label">@L["Connection string"]</label>
                        <input class="form-control" @bind="_edit.ConnectionString" />
                    </div>
                }
                <div class="col-12">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="tenant-active" @bind="_edit.IsActive" />
                        <label class="form-check-label" for="tenant-active">@L["Active"]</label>
                    </div>
                </div>
            </div>

            <h6 class="mt-4">@L["Subscribed modules"]</h6>
            @foreach (var m in _edit.Modules)
            {
                <div class="row g-2 align-items-center mb-1">
                    <div class="col-auto">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="@($"m-{m.Name}")" @bind="m.Enabled" />
                            <label class="form-check-label" for="@($"m-{m.Name}")">@ModuleTitle(m.Name)</label>
                        </div>
                    </div>
                    <div class="col-auto">
                        <input class="form-control form-control-sm" type="date" @bind="m.ExpiresOn"
                               disabled="@(!m.Enabled)" title="@L["Optional last day of the subscription"]" />
                    </div>
                </div>
            }

            <div class="mt-3">
                <button class="btn btn-primary btn-sm" @onclick="Save">@L["Save"]</button>
                <button class="btn btn-link btn-sm" @onclick="Cancel">@L["Cancel"]</button>
            </div>
        </div>
    </div>
}

@code {
    private List<TenantRow> _tenants = [];
    private TenantEditModel? _edit;
    private string? _message;
    private string? _error;

    private string ModuleTitle(string name) =>
        ModuleCatalog.Menu.TryGetValue(name, out var item) ? L[item.Title].Value : name;

    private static IReadOnlySet<string> Known =>
        ModuleCatalog.Menu.Keys.ToHashSet(StringComparer.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync() => await Run(Reload);

    private async Task Reload() => _tenants = await Admin.ListAsync();

    private void StartCreate()
    {
        Clear();
        _edit = new TenantEditModel
        {
            Modules = ModuleCatalog.Menu.Keys.Select(k => new ModuleSelection { Name = k }).ToList()
        };
    }

    private async Task StartEdit(Guid id) =>
        await Run(async () => _edit = await Admin.GetEditModelAsync(id, Known));

    private async Task Save() =>
        await Run(async () =>
        {
            await Admin.SaveAsync(_edit!, Known);
            _message = L["Tenant saved."];
            _edit = null;
            await Reload();
        });

    private async Task ToggleActive(TenantRow tenant) =>
        await Run(async () =>
        {
            await Admin.SetActiveAsync(tenant.Id, !tenant.IsActive);
            _message = tenant.IsActive ? L["Tenant deactivated."].Value : L["Tenant activated."].Value;
            await Reload();
        });

    private void Cancel()
    {
        Clear();
        _edit = null;
    }

    private async Task Run(Func<Task> action)
    {
        Clear();
        try
        {
            await action();
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException)
        {
            _error = L[ex.Message];
        }
    }

    private void Clear()
    {
        _message = null;
        _error = null;
    }
}

